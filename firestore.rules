rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function willBeOwner() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /{collection}/{docId} {
      allow read: if isOwner();
      allow create: if willBeOwner();
      allow update, delete: if isOwner() && willBeOwner();
    }
  }
}
